{
  "cleanUrls": true,
  "ignoreCommand": "P=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\"; git cat-file -e \"$P^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$P\" HEAD -- .",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "renpokernight.vercel.app"
        }
      ],
      "destination": "https://www.thepoker.study/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/discord?web=login"
    },
    {
      "source": "/api/casino",
      "destination": "/api/discord?web=casino"
    },
    {
      "source": "/api/shop",
      "destination": "/api/discord?web=shop"
    },
    {
      "source": "/api/poker",
      "destination": "/api/discord?web=poker"
    },
    {
      "source": "/api/live",
      "destination": "/api/discord?web=live"
    },
    {
      "source": "/api/me",
      "destination": "/api/discord?web=me"
    },
    {
      "source": "/api/recap",
      "destination": "/api/img?fn=recap"
    },
    {
      "source": "/api/card",
      "destination": "/api/img?fn=card"
    },
    {
      "source": "/api/hall",
      "destination": "/api/img?fn=hall"
    },
    {
      "source": "/api/h2h",
      "destination": "/api/img?fn=h2h"
    },
    {
      "source": "/api/wrap",
      "destination": "/api/img?fn=wrap"
    },
    {
      "source": "/api/bjcards",
      "destination": "/api/img?fn=bjcards"
    },
    {
      "source": "/api/seats",
      "destination": "/api/img?fn=seats"
    },
    {
      "source": "/api/roulette",
      "destination": "/api/img?fn=roulette"
    }
  ],
  "functions": {
    "api/discord.js": {
      "includeFiles": "{api/_assets/**,recap-core.js,loot.js,pokergame.js}",
      "maxDuration": 60,
      "excludeFiles": "node_modules/@resvg/resvg-js-linux-x64-musl/**"
    },
    "api/avatar.js": {
      "maxDuration": 20
    },
    "api/invite.js": {
      "includeFiles": "recap-core.js",
      "maxDuration": 15
    },
    "api/roles.js": {
      "includeFiles": "{recap-core.js,loot.js,pokergame.js}",
      "maxDuration": 30
    },
    "api/img.js": {
      "includeFiles": "{api/_assets/**,recap-core.js,loot.js}",
      "excludeFiles": "node_modules/@resvg/resvg-js-linux-x64-musl/**",
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/roles?weekly=1",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/roles?rakeback=1",
      "schedule": "5 16 * * 3"
    }
  ]
}
